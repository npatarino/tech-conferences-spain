{
  "name": "@chimichurricode/techconf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TechConf — Astro site listing Spanish tech conferences.",
  "scripts": {
    "dev": "astro dev",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "sync:seo": "node scripts/sync-seo.mjs",
    "sync": "npm run sync:fonts && npm run sync:seo",
    "predev": "npm run sync",
    "prebuild": "npm run sync",
    "build": "astro build",
    "check:slop": "node node_modules/@chimichurricode/design-system/scripts/check-slop.mjs --strict dist",
    "check:prose": "node node_modules/@chimichurricode/design-system/scripts/check-prose.mjs --strict dist",
    "preview": "astro preview",
    "astro": "astro",
    "validate:ote": "ote-validate dist/events.json"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@chimichurricode/analytics": "^0.1.0",
    "@chimichurricode/design-system": "^0.10.0",
    "@chimichurricode/preact-ui": "^0.1.1",
    "@chimichurricode/web-app-kit": "^0.1.3",
    "@opentechevents/export-ics": "^0.6.0",
    "astro": "^7.4.5",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@opentechevents/validate": "^0.6.0"
  },
  "overrides": {
    "@chimichurricode/web-app-kit": {
      "astro": "$astro"
    },
    "@chimichurricode/design-system": {
      "astro": "$astro"
    }
  }
}
