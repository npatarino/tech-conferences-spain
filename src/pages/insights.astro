---
/**
 * /insights — a data story about tech conferences in Spain.
 *
 * Every figure comes from `buildReport` (src/lib/insights.ts) at build
 * time; charts are server-rendered SVG/HTML so the page reads fine with no
 * JavaScript. The script at the bottom only adds interaction: tooltips,
 * the topic filter, the map's year scrubber and city cards, tabs, counters
 * and sharing.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { pageJsonLd } from "../seo";
import { todayIso } from "../lib/format.ts";
import { SPAIN_OUTLINE } from "../data/spain.ts";
import {
  buildEditions, buildReport, formatDateEs, weekSlot,
  MONTHS_SHORT, MONTHS_LONG, TOPIC_LABEL, WEEKDAYS,
} from "../lib/insights.ts";

const today = todayIso();
const editions = buildEditions(await getCollection("conferences"), today);
const r = buildReport(editions, today);
const { totals, calendar, languages, cfp, records } = r;

// ── map projection (equirectangular, Canary Islands moved into an inset)
const MAP_W = 700, MAP_K = 49.6, LON0 = -13.8, LAT0 = 44.0, COS = Math.cos((40 * Math.PI) / 180);
const CANARY = { dLon: 4.6, dLat: 6.6 };
const project = (lon: number, lat: number): [number, number] => {
  if (lat < 30) { lon += CANARY.dLon; lat += CANARY.dLat; }
  return [Math.round((lon - LON0) * COS * MAP_K * 10) / 10, Math.round((LAT0 - lat) * MAP_K * 10) / 10];
};
const MAP_H = Math.round((LAT0 - 33.9) * MAP_K);
const outlinePath = SPAIN_OUTLINE.map((ring) => ring.map(([lon, lat], i) => `${i ? "L" : "M"}${project(lon, lat).join(" ")}`).join("") + "Z").join("");
const radius = (n: number) => (n <= 0 ? 0 : Math.max(4, Math.sqrt(n) * 3.1));
const mapPlaces = r.places.map((p) => {
  const [x, y] = project(p.lon, p.lat);
  return { ...p, x, y };
});

// ── swarm: one row per year, one column per week, dots stacked upwards
const SW = { left: 52, cell: 17.8, pitch: 12.5, r: 5.2, pad: 14 };
const swarmYears = r.years.map((year) => {
  const eds = editions.filter((e) => e.year === year && !e.tbc);
  const stacks = new Map<number, number>();
  const dots = eds.map((e) => {
    const slot = weekSlot(e.start);
    const level = stacks.get(slot) ?? 0;
    stacks.set(slot, level + 1);
    return { e, slot, level };
  });
  const height = Math.max(3, ...stacks.values()) * SW.pitch + SW.pad;
  return { year, dots, height, count: eds.length };
});
let cursor = 26;
const swarmRows = swarmYears.map((row) => {
  const top = cursor;
  cursor += row.height;
  return { ...row, top, base: top + row.height - 6 };
});
const SWARM_W = SW.left + 53 * SW.cell + 8;
const SWARM_H = cursor + 6;
const monthTicks = MONTHS_SHORT.map((label, i) => ({ label, x: SW.left + (new Date(Date.UTC(2023, i, 1)).getTime() - Date.UTC(2023, 0, 1)) / (7 * 86_400_000) * SW.cell }));
const dotClass = (e: (typeof editions)[number]) => (e.state === "cancelled" ? "cancelled" : e.state === "upcoming" ? "upcoming" : e.online ? "online" : "held");
const STATE_LABEL: Record<string, string> = { held: "Celebrada", online: "Online", cancelled: "Cancelada", upcoming: "Próximamente" };
const dateRange = (e: (typeof editions)[number]) => (e.days > 1 ? `${formatDateEs(e.start, false)} – ${formatDateEs(e.end)}` : formatDateEs(e.start));

// ── copy helpers
const nf = (n: number) => n.toLocaleString("es-ES");
const worst = r.worstYear;
const worstShare = worst ? Math.round((worst.cancelled / Math.max(1, worst.total)) * 100) : 0;
const topMonth = calendar.topMonths[0];
const enGroup = languages.groups.find((g) => g.id === "en")!;
const mixedGroup = languages.groups.find((g) => g.id === "mixed")!;
const esGroup = languages.groups.find((g) => g.id === "es")!;
const oneIn = enGroup.share > 0 ? Math.round(100 / enGroup.share) : 0;
const LANG_LABEL: Record<string, string> = { es: "Español", mixed: "Bilingüe (es + en)", en: "Inglés", other: "Catalán y gallego" };
const LANG_SHORT: Record<string, string> = { es: "Español", mixed: "Bilingüe", en: "Inglés", other: "ca · gl" };
const shortDate = (iso: string) => `${Number(iso.slice(8, 10))} ${MONTHS_SHORT[Number(iso.slice(5, 7)) - 1].toLowerCase()}`;
const topTopic = r.topics.filter((t) => t.id !== "general")[0];
const general = r.topics.find((t) => t.id === "general");
const ia = r.topics.find((t) => t.id === "ia");
const maxTopic = Math.max(...r.topics.map((t) => t.count));
const maxYearTotal = Math.max(...r.perYear.map((p) => p.total));
const maxRegion = r.regions[0]?.count ?? 1;
const lifelineYears = r.years;
const maxConc = Math.max(...r.concentration.map((c) => c.share), 1);
const spark = (values: number[]) => {
  const max = Math.max(...values, 1);
  return values.map((v, i) => `${(i / Math.max(1, values.length - 1)) * 100},${22 - (v / max) * 20}`).join(" ");
};
const nomadMap = (stops: { lat: number; lon: number }[]) => stops.map((s) => project(s.lon, s.lat));

const chapters = [
  { id: "pulso", label: "El pulso" },
  { id: "pandemia", label: "2020" },
  { id: "mapa", label: "El mapa" },
  { id: "temas", label: "Temas" },
  { id: "idiomas", label: "Idiomas" },
  { id: "calendario", label: "Calendario" },
  { id: "longevidad", label: "Longevidad" },
  { id: "gira", label: "De gira" },
  { id: "cfp", label: "CFP" },
  { id: "records", label: "Récords" },
];

const title = "Radiografía de las conferencias tech en España";
const description = `${nf(totals.held)} conferencias celebradas, ${totals.places} ciudades y ${totals.currentYear - totals.firstYear + 1} años de datos abiertos: dónde, cuándo, de qué y en qué idioma se hacen las conferencias de software en España.`;
const clientData = {
  years: r.pastYears,
  places: mapPlaces.map((p) => ({ place: p.place, region: p.region, x: p.x, y: p.y, total: p.total, byYear: p.byYear, firstYear: p.firstYear, families: p.families, topTopic: TOPIC_LABEL[p.topTopic] })),
};
---

<Base title={title} description={description} recipe="canvas-signal" seo={{ jsonLd: [pageJsonLd({ name: title, description, url: "/insights" })] }}>
  <div class="story">
    <header class="hero">
      <span class="eyebrow">Insights · datos abiertos · {totals.firstYear}–{totals.currentYear}</span>
      <h1 class="hero-title">
        <span><b data-count={totals.held}>{nf(totals.held)}</b> conferencias.</span>
        <span><b data-count={totals.places}>{totals.places}</b> ciudades.</span>
        <span><b data-count={totals.currentYear - totals.firstYear + 1}>{totals.currentYear - totals.firstYear + 1}</b> años.</span>
      </h1>
      <p class="lede">
        Esta es la radiografía de las conferencias de software en España: quién las monta, dónde, cuándo,
        de qué se habla y cuáles ya no volvieron. Todo sale de un repositorio abierto que mantiene la comunidad,
        y cada número de esta página se recalcula solo cuando alguien añade una conferencia.
      </p>
      <dl class="hero-stats">
        <div><dt>Eventos distintos</dt><dd data-count={totals.families}>{totals.families}</dd></div>
        <div><dt>Días de conferencia</dt><dd data-count={totals.daysOfConference}>{nf(totals.daysOfConference)}</dd></div>
        <div><dt>Canceladas</dt><dd data-count={totals.cancelled}>{totals.cancelled}</dd></div>
        <div><dt>Ya anunciadas</dt><dd data-count={totals.upcoming}>{totals.upcoming}</dd></div>
      </dl>
      <div class="hero-actions">
        <button class="btn-share" type="button" data-share data-share-text={`${nf(totals.held)} conferencias tech, ${totals.places} ciudades, ${totals.currentYear - totals.firstYear + 1} años: la radiografía de las conferencias de software en España.`}>Compartir</button>
        <a class="btn-ghost" href="#pulso">Empezar ↓</a>
      </div>
    </header>

    <nav class="chapters" aria-label="Capítulos">
      {chapters.map((c) => <a href={`#${c.id}`} data-chapter={c.id}>{c.label}</a>)}
    </nav>

    <!-- 1 · El pulso -->
    <section class="chapter" id="pulso" data-reveal>
      <p class="kicker">01 · El pulso</p>
      <h2>Cada punto es una conferencia</h2>
      <p class="take">
        Una fila por año, una columna por semana. Los {nf(totals.editions)} puntos son todas las ediciones registradas
        desde {totals.firstYear}: pasa el ratón (o el dedo) por encima para ver cuál es, y pulsa para ir a su web.
        Filtra por tema y mira cómo cambia el dibujo.
      </p>
      <div class="chips" role="group" aria-label="Filtrar por tema" data-filter-group>
        <button type="button" class="chip is-on" data-topic="">Todas <span>{totals.editions}</span></button>
        {r.topics.map((t) => <button type="button" class="chip" data-topic={t.id}>{t.label} <span>{editions.filter((e) => e.topic === t.id).length}</span></button>)}
      </div>
      <p class="swipe-hint" aria-hidden="true">Desliza para ver todo el año →</p>
      <div class="swarm-scroll">
        <svg class="swarm" viewBox={`0 0 ${SWARM_W} ${SWARM_H}`} role="img" aria-label={`Calendario de ${totals.editions} ediciones de conferencias por semana y año`}>
          {monthTicks.map((m) => <text class="axis" x={m.x + 4} y="14">{m.label}</text>)}
          {monthTicks.map((m) => <line class="grid" x1={m.x} x2={m.x} y1="20" y2={SWARM_H - 6} />)}
          {swarmRows.map((row) => (
            <g>
              <text class="year" x="0" y={row.base - 2}>{row.year}</text>
              <text class="year-count" x={SWARM_W - 4} y={row.top + 12} text-anchor="end">{row.count}</text>
              <line class="base" x1={SW.left} x2={SWARM_W - 8} y1={row.base + SW.r + 2} y2={row.base + SW.r + 2} />
              {row.dots.map(({ e, slot, level }) => {
                const cx = SW.left + slot * SW.cell + SW.cell / 2;
                const cy = row.base - level * SW.pitch;
                const tip = `${e.name} ${e.year}|${dateRange(e)} · ${e.place}|${STATE_LABEL[dotClass(e)]} · ${TOPIC_LABEL[e.topic]}`;
                const circle = <circle class={`dot ${dotClass(e)}`} cx={cx} cy={cy} r={SW.r} data-topic={e.topic} data-tip={tip} tabindex={e.website ? undefined : "0"} />;
                return e.website ? <a href={e.website} target="_blank" rel="noopener" aria-label={`${e.name} ${e.year}, ${e.place}`}>{circle}</a> : circle;
              })}
            </g>
          ))}
        </svg>
      </div>
      <ul class="legend">
        <li><i class="dot-key held"></i>Presencial</li>
        <li><i class="dot-key online"></i>Online</li>
        <li><i class="dot-key cancelled"></i>Cancelada</li>
        <li><i class="dot-key upcoming"></i>Anunciada</li>
      </ul>
      <button class="share-link" type="button" data-share data-share-hash="pulso" data-share-text={`Cada punto es una conferencia: ${nf(totals.editions)} ediciones de conferencias tech en España desde ${totals.firstYear}, semana a semana.`}>Compartir este gráfico</button>
    </section>

    <!-- 2 · Pandemia -->
    {worst && worst.cancelled > 0 && (
      <section class="chapter" id="pandemia" data-reveal>
        <p class="kicker">02 · El año que se apagó todo</p>
        <h2>En {worst.year} se canceló el <em>{worstShare}%</em> del calendario</h2>
        <p class="take">
          De las {worst.total} conferencias previstas para {worst.year}, <strong>{worst.cancelled}</strong> se cancelaron
          y <strong>{worst.online}</strong> se pasaron a online.
          {r.onlinePeak && r.onlinePeak.online > 0 && <> El formato online tocó techo en {r.onlinePeak.year}, con {r.onlinePeak.online} ediciones.</>}
          {r.quietYear && <> El año más flojo fue {r.quietYear.year}: solo {r.quietYear.inPerson + r.quietYear.online} conferencias celebradas.</>}
          {r.peakYear && <> El más cargado, {r.peakYear.year}, con {r.peakYear.inPerson + r.peakYear.online + r.peakYear.upcoming}.</>}
        </p>
        <div class="yearbars" role="img" aria-label="Conferencias por año, separadas en presenciales, online, canceladas y anunciadas">
          {r.perYear.map((p) => (
            <div class="yearbar">
              <div class="yearbar-stack" style={`height:${(p.total / maxYearTotal) * 100}%`}>
                {p.cancelled > 0 && <span class="seg cancelled" style={`flex:${p.cancelled}`} data-tip={`${p.year}|${p.cancelled} canceladas`}></span>}
                {p.upcoming > 0 && <span class="seg upcoming" style={`flex:${p.upcoming}`} data-tip={`${p.year}|${p.upcoming} anunciadas`}></span>}
                {p.online > 0 && <span class="seg online" style={`flex:${p.online}`} data-tip={`${p.year}|${p.online} online`}></span>}
                {p.inPerson > 0 && <span class="seg held" style={`flex:${p.inPerson}`} data-tip={`${p.year}|${p.inPerson} presenciales`}></span>}
              </div>
              <span class="yearbar-total">{p.total}</span>
              <span class="yearbar-year">{p.year}</span>
            </div>
          ))}
        </div>
        <ul class="legend">
          <li><i class="sq held"></i>Presencial</li>
          <li><i class="sq online"></i>Online</li>
          <li><i class="sq cancelled"></i>Cancelada</li>
          <li><i class="sq upcoming"></i>Anunciada</li>
        </ul>
        <button class="share-link" type="button" data-share data-share-hash="pandemia" data-share-text={`En ${worst.year} se canceló el ${worstShare}% de las conferencias tech en España (${worst.cancelled} de ${worst.total}).`}>Compartir este dato</button>
      </section>
    )}

    <!-- 3 · Mapa -->
    <section class="chapter" id="mapa" data-reveal>
      <p class="kicker">03 · El mapa</p>
      <h2>El <em>{r.bigTwoShare}%</em> pasa por Madrid o Barcelona</h2>
      <p class="take">
        Las conferencias presenciales han pisado <strong>{totals.places} ciudades</strong> de {totals.regions} comunidades autónomas.
        Mueve el año para ver cómo se va encendiendo el mapa y pulsa una ciudad para ver qué se cuece allí.
        {r.emptyRegions.length > 0 && <> Sin ninguna conferencia registrada todavía: {r.emptyRegions.join(", ")}.</>}
      </p>
      <div class="map-layout">
        <div class="map-wrap">
          <svg class="map" viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-label="Mapa de España con las ciudades que han tenido conferencias">
            <path class="land" d={outlinePath} />
            <rect class="inset" x="4" y={MAP_H - 104} width="258" height="100" rx="8" />
            <text class="inset-label" x="14" y={MAP_H - 88}>Canarias</text>
            <g data-bubbles>
              {mapPlaces.slice().reverse().map((p) => (
                <circle class="bubble" cx={p.x} cy={p.y} r={radius(p.total)} data-place={p.place} tabindex="0" role="button" aria-label={`${p.place}: ${p.total} conferencias`} />
              ))}
            </g>
            {mapPlaces.slice(0, 7).map((p) => <text class="city-label" x={p.x} y={p.y - radius(p.total) - 5} text-anchor="middle" data-label={p.place}>{p.place}</text>)}
          </svg>
          <div class="scrub">
            <button type="button" class="scrub-play" data-play aria-label="Reproducir la evolución por años">▶</button>
            <input type="range" min={r.pastYears[0]} max={r.pastYears[r.pastYears.length - 1]} value={r.pastYears[r.pastYears.length - 1]} step="1" data-year aria-label="Año" />
            <output data-year-out>{totals.firstYear}–{totals.currentYear}</output>
          </div>
        </div>
        <aside class="city-card" data-city-card aria-live="polite">
          <p class="city-eyebrow">Ciudad</p>
          <h3 data-city-name>{mapPlaces[0]?.place}</h3>
          <p class="city-big"><b data-city-total>{mapPlaces[0]?.total}</b> conferencias</p>
          <p class="city-meta" data-city-meta>{mapPlaces[0]?.region} · desde {mapPlaces[0]?.firstYear} · sobre todo {TOPIC_LABEL[mapPlaces[0]?.topTopic ?? "general"]?.toLowerCase()}</p>
          <ol class="city-list" data-city-list>
            {mapPlaces[0]?.families.map((f) => <li>{f.website ? <a href={f.website} target="_blank" rel="noopener">{f.family}</a> : f.family}<span>{f.editions}</span></li>)}
          </ol>
          <button class="share-link" type="button" data-share data-share-city>Compartir mi ciudad</button>
        </aside>
      </div>

      <div class="duo">
        <div>
          <h3 class="sub">Por comunidad autónoma</h3>
          <ol class="bars">
            {r.regions.map((x) => (
              <li><span class="bar-name">{x.region}</span><span class="bar-track"><span class="bar-fill" style={`width:${(x.count / maxRegion) * 100}%`}></span></span><span class="bar-num">{x.count}</span></li>
            ))}
          </ol>
        </div>
        <div>
          <h3 class="sub">Peso de Madrid + Barcelona, año a año</h3>
          <div class="cols" role="img" aria-label="Porcentaje de conferencias presenciales en Madrid o Barcelona por año">
            {r.concentration.map((c) => (
              <div class="col"><span class="col-num">{c.share}%</span><span class="col-bar" style={`height:${(c.share / maxConc) * 100}%`}></span><span class="col-year">{String(c.year).slice(2)}</span></div>
            ))}
          </div>
          {r.newPlaces.length > 0 && <p class="note">Ciudades que se han estrenado desde {totals.currentYear - 1}: {r.newPlaces.join(", ")}.</p>}
        </div>
      </div>
    </section>

    <!-- 4 · Temas -->
    <section class="chapter" id="temas" data-reveal>
      <p class="kicker">04 · De qué se habla</p>
      <h2>
        {ia && r.iaFirstBoomYear
          ? <>La IA no tenía conferencia propia hasta <em>{r.iaFirstBoomYear}</em></>
          : <>{topTopic?.label} manda entre las especializadas</>}
      </h2>
      <p class="take">
        {general && <>El <strong>{general.share}%</strong> de las conferencias son generalistas: caben todos los temas. </>}
        {topTopic && <>Entre las especializadas, lo que más abunda es <strong>{topTopic.label.toLowerCase()}</strong> ({topTopic.count} ediciones). </>}
        {ia && <>Las de IA suman ya {ia.count}, casi todas en los dos últimos años. </>}
        La línea de cada fila es su evolución desde {totals.firstYear}.
      </p>
      <ol class="topics">
        {r.topics.map((t) => (
          <li>
            <span class="topic-name">{t.label}</span>
            <span class="bar-track"><span class="bar-fill" style={`width:${(t.count / maxTopic) * 100}%`}></span></span>
            <span class="bar-num">{t.count}</span>
            <svg class="spark" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true"><polyline points={spark(t.byYear)} /></svg>
            <span class="topic-ex">{t.examples.join(" · ")}</span>
          </li>
        ))}
      </ol>
      <h3 class="sub">Las etiquetas más repetidas</h3>
      <p class="tags">
        {r.tagCounts.map((t) => <span style={`font-size:${Math.min(30, 12 + t.count * 0.45)}px`}>{t.tag}<sup>{t.count}</sup></span>)}
      </p>
    </section>

    <!-- 5 · Idiomas -->
    <section class="chapter" id="idiomas" data-reveal>
      <p class="kicker">05 · En qué idioma</p>
      <h2>{oneIn > 1 ? <>Una de cada <em>{oneIn}</em> se da solo en inglés</> : <>El español manda en el escenario</>}</h2>
      <p class="take">
        De las {languages.known} ediciones con idioma conocido, el <strong>{esGroup.share}%</strong> son en español,
        el <strong>{enGroup.share}%</strong> íntegramente en inglés y el <strong>{mixedGroup.share}%</strong> mezclan los dos.
        {languages.englishCities.length > 0 && <> Donde más se oye inglés: {languages.englishCities.map((c) => `${c.place} (${c.count})`).join(", ")}.</>}
      </p>
      <div class="langbar" role="img" aria-label="Reparto de idiomas">
        {languages.groups.filter((g) => g.count > 0).map((g) => (
          <span class={`lang ${g.id}`} style={`flex:${g.count}`} data-tip={`${LANG_LABEL[g.id]}|${g.count} ediciones · ${g.share}%`}><b>{g.share}%</b>{LANG_SHORT[g.id]}</span>
        ))}
      </div>
      <h3 class="sub">Año a año</h3>
      <div class="langyears">
        {languages.byYear.map((y) => (
          <div class="langyear">
            <span class="langyear-year">{y.year}</span>
            <span class="langyear-bar">
              <span class="lang es" style={`flex:${y.es}`}></span>
              <span class="lang mixed" style={`flex:${y.mixed}`}></span>
              <span class="lang en" style={`flex:${y.en}`}></span>
              <span class="lang other" style={`flex:${y.other}`}></span>
            </span>
            <span class="langyear-num">{y.en}% en</span>
          </div>
        ))}
      </div>
      <p class="note">El idioma está anotado a mano, evento a evento; {languages.unknown} ediciones aún no lo tienen y quedan fuera del cálculo.</p>
    </section>

    <!-- 6 · Calendario -->
    <section class="chapter" id="calendario" data-reveal>
      <p class="kicker">06 · Cuándo</p>
      <h2>{MONTHS_LONG[topMonth.month][0].toUpperCase() + MONTHS_LONG[topMonth.month].slice(1)} se lleva el <em>{topMonth.share}%</em> del año</h2>
      <p class="take">
        Si organizas una conferencia en {MONTHS_LONG[topMonth.month]}, compites con todo el mundo; le sigue {MONTHS_LONG[calendar.topMonths[1].month]} ({calendar.topMonths[1].share}%).
        En julio y agosto, en cambio, solo ha habido <strong>{calendar.summer}</strong> conferencias en {r.pastYears.length} años.
        {calendar.busiestDay && <> El día con más conferencias a la vez fue el <strong>{formatDateEs(calendar.busiestDay.date)}</strong>: {calendar.busiestDay.names.length} simultáneas ({calendar.busiestDay.names.join(", ")}).</>}
      </p>
      <div class="heat-scroll">
        <table class="heat">
          <thead><tr><th></th>{MONTHS_SHORT.map((m) => <th scope="col">{m}</th>)}</tr></thead>
          <tbody>
            {calendar.matrix.map((row) => (
              <tr>
                <th scope="row">{row.year}</th>
                {row.months.map((n, i) => <td style={`--v:${n / calendar.matrixMax}`} data-tip={`${MONTHS_LONG[i]} de ${row.year}|${n} conferencias`}>{n || ""}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="duo">
        <div>
          <h3 class="sub">Día en que empiezan</h3>
          <div class="cols">
            {calendar.byWeekday.map((n, i) => (
              <div class="col"><span class="col-num">{n}</span><span class="col-bar" style={`height:${(n / Math.max(...calendar.byWeekday)) * 100}%`}></span><span class="col-year">{WEEKDAYS[i].slice(0, 1)}</span></div>
            ))}
          </div>
          <p class="note">{WEEKDAYS[calendar.topWeekdays[0].day]} ({calendar.topWeekdays[0].share}%) y {WEEKDAYS[calendar.topWeekdays[1].day].toLowerCase()} ({calendar.topWeekdays[1].share}%) son los días favoritos para arrancar. En fin de semana empieza el {calendar.weekendShare}%.</p>
        </div>
        <div>
          <h3 class="sub">Cuánto duran</h3>
          <div class="langbar durbar">
            {calendar.durations.map((d, i) => (
              <span class={`lang d${i}`} style={`flex:${d.count}`} data-tip={`${d.days === 3 ? "3 días o más" : d.days === 1 ? "1 día" : "2 días"}|${d.count} ediciones`}><b>{Math.round((d.count / calendar.durationTotal) * 100)}%</b>{d.days === 3 ? "3+ días" : d.days === 1 ? "1 día" : "2 días"}</span>
            ))}
          </div>
          <p class="note">En total, {nf(totals.daysOfConference)} días de conferencia: {(totals.daysOfConference / 365).toFixed(1).replace(".", ",")} años seguidos de charlas.</p>
        </div>
      </div>
      <button class="share-link" type="button" data-share data-share-hash="calendario" data-share-text={`${MONTHS_LONG[topMonth.month][0].toUpperCase() + MONTHS_LONG[topMonth.month].slice(1)} concentra el ${topMonth.share}% de las conferencias tech de España. En julio y agosto: ${calendar.summer} en ${r.pastYears.length} años.`}>Compartir este dato</button>
    </section>

    <!-- 7 · Longevidad -->
    <section class="chapter" id="longevidad" data-reveal>
      <p class="kicker">07 · Las que duran</p>
      <h2>El <em>{r.aliveShare}%</em> de los eventos sigue en pie</h2>
      <p class="take">
        De {totals.families} eventos distintos, {r.multiCount} han repetido edición.
        De los {r.survivors.of} que tuvieron edición en {totals.firstYear}, <strong>{r.survivors.alive}</strong> siguen celebrándose.
        Estos son los {r.lifelines.length} con más ediciones: cada casilla es un año.
      </p>
      <div class="life-scroll">
        <table class="life">
          <thead><tr><th></th>{lifelineYears.map((y) => <th scope="col">{String(y).slice(2)}</th>)}<th scope="col" class="life-n">Ed.</th></tr></thead>
          <tbody>
            {r.lifelines.map((f) => (
              <tr>
                <th scope="row">{f.website ? <a href={f.website} target="_blank" rel="noopener">{f.family}</a> : f.family}</th>
                {lifelineYears.map((y) => <td><i class={`cell ${f.byYear[y] ?? "none"}`} data-tip={f.byYear[y] ? `${f.family} ${y}|${STATE_LABEL[f.byYear[y] === "held" ? "held" : f.byYear[y]]}` : undefined}></i></td>)}
                <td class="life-n">{f.editions}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="legend">
        <li><i class="cell held"></i>Celebrada</li>
        <li><i class="cell cancelled"></i>Cancelada</li>
        <li><i class="cell upcoming"></i>Anunciada</li>
      </ul>

      {r.memoriam.length > 0 && (
        <div class="memoriam">
          <h3 class="sub">Las que echamos de menos</h3>
          <p class="note">Tuvieron al menos dos ediciones y llevan tres años o más sin volver. Otros {r.oneShots} eventos se quedaron en una única edición.</p>
          <ul class="stones">
            {r.memoriam.map((f) => (
              <li><span class="stone-name">{f.family}</span><span class="stone-years">{f.firstYear}–{f.lastYear}</span><span class="stone-meta">{f.held} ediciones · {f.places[0] ?? "Online"}</span></li>
            ))}
          </ul>
        </div>
      )}
    </section>

    <!-- 8 · De gira -->
    {r.nomads.length > 0 && (
      <section class="chapter" id="gira" data-reveal>
        <p class="kicker">08 · De gira</p>
        <h2>Las conferencias que <em>cambian de ciudad</em> cada año</h2>
        <p class="take">
          Algunas no tienen casa fija: cada edición la organiza una comunidad local distinta.
          {r.franchises.length > 0 && <> Y luego están las franquicias: {r.franchises.map((f) => `${f.family} (${f.places} ciudades)`).join(", ")}.</>}
        </p>
        <div class="tabs" role="tablist" aria-label="Conferencias itinerantes">
          {r.nomads.map((n, i) => <button type="button" role="tab" class:list={["tab", { "is-on": i === 0 }]} aria-selected={i === 0 ? "true" : "false"} data-tab={`gira-${i}`}>{n.family}</button>)}
        </div>
        {r.nomads.map((n, i) => {
          const pts = nomadMap(n.stops);
          return (
            <div class="route" data-panel={`gira-${i}`} hidden={i !== 0}>
              <svg class="map route-map" viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-label={`Ruta de ${n.family}`}>
                <path class="land" d={outlinePath} />
                <polyline class="route-line" points={pts.map((p) => p.join(",")).join(" ")} />
                {pts.map(([x, y], j) => (
                  <g><circle class="route-stop" cx={x} cy={y} r="11" /><text class="route-num" x={x} y={y + 4} text-anchor="middle">{j + 1}</text></g>
                ))}
              </svg>
              <ol class="route-list">
                {n.stops.map((s) => <li><b>{s.year}</b> {s.place}</li>)}
              </ol>
            </div>
          );
        })}
      </section>
    )}

    <!-- 9 · CFP -->
    <section class="chapter" id="cfp" data-reveal>
      <p class="kicker">09 · Si quieres dar una charla</p>
      <h2>El CFP cierra <em>{cfp.medianLead} días</em> antes del evento</h2>
      <p class="take">
        Es la mediana de las {cfp.documented} convocatorias con fecha registrada.
        {cfp.medianWindow != null && <> La ventana para enviar propuestas dura unos <strong>{cfp.medianWindow} días</strong>.</>}
        {cfp.topCloseMonth && <> El mes en que más convocatorias cierran es <strong>{MONTHS_LONG[cfp.topCloseMonth.month]}</strong>.</>}
      </p>
      <div class="duo">
        <div>
          <h3 class="sub">Abiertos ahora mismo</h3>
          {cfp.openNow.length > 0 ? (
            <ul class="open-cfp">
              {cfp.openNow.map((c) => (
                <li>
                  <a href={c.site ?? "#"} target="_blank" rel="noopener">{c.name} {c.year}</a>
                  <span class="open-meta">{c.place} · {formatDateEs(c.eventStart)}</span>
                  <span class:list={["open-left", { urgent: c.daysLeft <= 14 }]}>{c.daysLeft === 0 ? "cierra hoy" : `quedan ${c.daysLeft} días`}</span>
                </li>
              ))}
            </ul>
          ) : <p class="note">Ahora mismo no hay ninguna convocatoria abierta registrada.</p>}
        </div>
        <div>
          <h3 class="sub">Mes de cierre de las convocatorias</h3>
          <div class="cols">
            {cfp.closeMonths.map((n, i) => (
              <div class="col"><span class="col-num">{n || ""}</span><span class="col-bar" style={`height:${(n / Math.max(...cfp.closeMonths, 1)) * 100}%`}></span><span class="col-year">{MONTHS_SHORT[i].slice(0, 1)}</span></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 10 · Récords -->
    <section class="chapter" id="records" data-reveal>
      <p class="kicker">10 · Récords</p>
      <h2>Los datos que no caben en un gráfico</h2>
      <ul class="records">
        {records.mostEditions && <li><b>{records.mostEditions.editions}</b><span>ediciones</span><p>{records.mostEditions.family} es la conferencia con más ediciones (sin contar franquicias como DevFest).</p></li>}
        {records.topPlace && <li><b>{records.topPlace.total}</b><span>en una ciudad</span><p>{records.topPlace.place} es la ciudad con más conferencias.</p></li>}
        {calendar.busiestDay && <li><b>{calendar.busiestDay.names.length}</b><span>a la vez</span><p>El {formatDateEs(calendar.busiestDay.date)}, el día con más conferencias simultáneas.</p></li>}
        {records.widest && <li><b>{records.widest.places.length}</b><span>ciudades</span><p>{records.widest.family} es la marca que más ciudades ha pisado.</p></li>}
        {records.longest && <li><b>{records.longest.days}</b><span>días seguidos</span><p>{records.longest.name} {records.longest.year}, la conferencia más larga.</p></li>}
        {records.north && records.south && <li><b>{Math.round((records.north.lat - records.south.lat) * 111)}</b><span>km de norte a sur</span><p>De {records.north.place} a {records.south.place}, sin contar Canarias.</p></li>}
        {records.earliest && <li><b>{shortDate(records.earliest.start)}</b><span>la más madrugadora</span><p>{records.earliest.name} {records.earliest.year} abrió el año antes que nadie.</p></li>}
        {records.latest && <li><b>{shortDate(records.latest.start)}</b><span>la última del año</span><p>{records.latest.name} {records.latest.year} apuró el calendario al máximo.</p></li>}
      </ul>
    </section>

    <!-- Cierre -->
    <section class="chapter outro" data-reveal>
      <h2>¿Falta tu conferencia?</h2>
      <p class="take">
        Todo esto sale de ficheros de texto en un repositorio público. Añadir una conferencia es abrir un pull request,
        y los datos se pueden reutilizar libremente (CC BY 4.0) en formato <a href="/events.json">OpenTechEvents</a> o como <a href="/events.ics">calendario</a>.
      </p>
      <div class="hero-actions">
        <a class="btn-share" href="https://github.com/npatarino/tech-conferences-spain/#adding-a-conference" target="_blank" rel="noopener">Añadir una conferencia</a>
        <button class="btn-ghost" type="button" data-share data-share-text={`La radiografía de las conferencias tech en España: ${nf(totals.held)} conferencias, ${totals.places} ciudades, ${totals.currentYear - totals.firstYear + 1} años de datos abiertos.`}>Compartir la página</button>
      </div>
      <details class="method">
        <summary>Cómo se han calculado estos datos</summary>
        <ul>
          <li>Fuente: las {nf(totals.editions)} ediciones de <a href="https://github.com/npatarino/tech-conferences-spain" target="_blank" rel="noopener">tech-conferences-spain</a> a {formatDateEs(today)}. Solo conferencias; no hay meetups ni talleres.</li>
          <li>Es un listado mantenido a mano: lo que no está aquí no cuenta. Los años recientes están mejor cubiertos que los primeros, así que parte del crecimiento es mejor registro, no más conferencias.</li>
          <li>Un «evento» agrupa todas las ediciones de una misma marca, aunque cambie de ciudad (DevFest, WordCamp, PyConES…).</li>
          <li>Las canceladas se cuentan aparte y no entran en mapas, temas, idiomas ni calendario. Las ediciones con fecha por confirmar no entran en el calendario.</li>
          <li>Temas e idiomas están etiquetados a mano y con el mejor criterio posible; si ves un error, corrígelo con un pull request.</li>
          <li>Contorno del mapa: Natural Earth (dominio público).</li>
        </ul>
      </details>
    </section>
  </div>

  <div class="tip" data-tooltip hidden></div>
  <div class="toast" data-toast hidden role="status"></div>
  <script type="application/json" id="insights-data" set:html={JSON.stringify(clientData)} />
</Base>

<script>
  type Place = { place: string; region: string | null; x: number; y: number; total: number; byYear: Record<string, number>; firstYear: number; families: { family: string; editions: number; website: string | null }[]; topTopic: string };
  const data: { years: number[]; places: Place[] } = JSON.parse(document.getElementById("insights-data")!.textContent || "{}");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const $ = <T extends Element>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel);
  const $$ = <T extends Element>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];

  // ── tooltip (shared by every [data-tip])
  const tip = $<HTMLElement>("[data-tooltip]")!;
  function showTip(target: Element, x: number, y: number) {
    const [head, ...rest] = (target.getAttribute("data-tip") || "").split("|");
    tip.replaceChildren();
    const b = document.createElement("b");
    b.textContent = head;
    tip.append(b);
    for (const line of rest) {
      const s = document.createElement("span");
      s.textContent = line;
      tip.append(s);
    }
    tip.hidden = false;
    const w = tip.offsetWidth, h = tip.offsetHeight;
    tip.style.left = `${Math.max(8, Math.min(window.innerWidth - w - 8, x - w / 2))}px`;
    tip.style.top = `${y - h - 14 < 8 ? y + 18 : y - h - 14}px`;
  }
  document.addEventListener("pointermove", (ev) => {
    const t = (ev.target as Element).closest?.("[data-tip]");
    if (t) showTip(t, ev.clientX, ev.clientY);
    else tip.hidden = true;
  });
  document.addEventListener("focusin", (ev) => {
    const t = (ev.target as Element).closest?.("a, [data-tip]")?.querySelector?.("[data-tip]") ?? (ev.target as Element).closest?.("[data-tip]");
    if (!t) return;
    const box = t.getBoundingClientRect();
    showTip(t, box.left + box.width / 2, box.top);
  });
  document.addEventListener("focusout", () => { tip.hidden = true; });
  window.addEventListener("scroll", () => { tip.hidden = true; }, { passive: true });

  // ── topic filter on the swarm
  const swarm = $<SVGElement>(".swarm");
  for (const chip of $$<HTMLButtonElement>("[data-filter-group] .chip")) {
    chip.addEventListener("click", () => {
      const topic = chip.dataset.topic || "";
      for (const c of $$("[data-filter-group] .chip")) c.classList.toggle("is-on", c === chip);
      for (const dot of $$<SVGCircleElement>(".dot", swarm!)) dot.classList.toggle("dim", topic !== "" && dot.dataset.topic !== topic);
    });
  }

  // ── map: year scrubber, play, city card
  const range = $<HTMLInputElement>("[data-year]");
  const out = $<HTMLOutputElement>("[data-year-out]");
  const play = $<HTMLButtonElement>("[data-play]");
  const radius = (n: number) => (n <= 0 ? 0 : Math.max(4, Math.sqrt(n) * 3.1));
  const first = data.years[0], last = data.years[data.years.length - 1];
  let currentPlace = data.places[0]?.place ?? "";
  const upTo = (p: Place, year: number) => Object.entries(p.byYear).reduce((a, [y, n]) => a + (Number(y) <= year ? n : 0), 0);

  function paintMap(year: number) {
    for (const c of $$<SVGCircleElement>(".bubble")) {
      const p = data.places.find((x) => x.place === c.dataset.place)!;
      const n = upTo(p, year);
      c.setAttribute("r", String(radius(n)));
      c.classList.toggle("is-off", n === 0);
    }
    for (const t of $$<SVGTextElement>(".city-label")) {
      const p = data.places.find((x) => x.place === t.dataset.label)!;
      const n = upTo(p, year);
      t.setAttribute("y", String(p.y - radius(n) - 5));
      t.style.opacity = n === 0 ? "0" : "";
    }
    if (out) out.textContent = year >= last ? `${first}–${last}` : year === first ? String(first) : `${first}–${year}`;
    paintCity(currentPlace, year);
  }

  function paintCity(place: string, year = Number(range?.value ?? last)) {
    const p = data.places.find((x) => x.place === place);
    if (!p) return;
    currentPlace = place;
    for (const c of $$<SVGCircleElement>(".bubble")) c.classList.toggle("is-sel", c.dataset.place === place);
    $("[data-city-name]")!.textContent = p.place;
    $("[data-city-total]")!.textContent = String(upTo(p, year));
    $("[data-city-meta]")!.textContent = `${p.region ?? "España"} · desde ${p.firstYear} · sobre todo ${p.topTopic.toLowerCase()}`;
    const list = $("[data-city-list]")!;
    list.replaceChildren();
    for (const f of p.families) {
      const li = document.createElement("li");
      if (f.website) {
        const a = document.createElement("a");
        a.href = f.website; a.target = "_blank"; a.rel = "noopener"; a.textContent = f.family;
        li.append(a);
      } else li.append(f.family);
      const n = document.createElement("span");
      n.textContent = String(f.editions);
      li.append(n);
      list.append(li);
    }
  }

  range?.addEventListener("input", () => paintMap(Number(range.value)));
  for (const c of $$<SVGCircleElement>(".bubble")) {
    const pick = () => paintCity(c.dataset.place!);
    c.addEventListener("click", pick);
    c.addEventListener("keydown", (ev) => { if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); pick(); } });
    c.addEventListener("pointerenter", pick);
  }
  let timer: number | undefined;
  play?.addEventListener("click", () => {
    if (!range) return;
    if (timer) { clearInterval(timer); timer = undefined; play.textContent = "▶"; return; }
    play.textContent = "❚❚";
    let y = first;
    range.value = String(y);
    paintMap(y);
    timer = window.setInterval(() => {
      y++;
      range.value = String(y);
      paintMap(y);
      if (y >= last) { clearInterval(timer); timer = undefined; play.textContent = "▶"; }
    }, reduced ? 300 : 900);
  });
  // deep link: /insights#ciudad=Valencia
  const cityFromHash = () => {
    const m = decodeURIComponent(location.hash).match(/^#ciudad=(.+)$/);
    if (m && data.places.some((p) => p.place === m[1])) {
      paintCity(m[1]);
      $("#mapa")?.scrollIntoView();
    }
  };
  cityFromHash();
  window.addEventListener("hashchange", cityFromHash);

  // ── tabs (nomad routes)
  for (const tab of $$<HTMLButtonElement>("[data-tab]")) {
    tab.addEventListener("click", () => {
      for (const t of $$<HTMLButtonElement>("[data-tab]")) {
        const on = t === tab;
        t.classList.toggle("is-on", on);
        t.setAttribute("aria-selected", String(on));
        const panel = $<HTMLElement>(`[data-panel="${t.dataset.tab}"]`);
        if (panel) panel.hidden = !on;
      }
    });
  }

  // ── counters
  const fmt = new Intl.NumberFormat("es-ES");
  const counters = new IntersectionObserver((entries) => {
    for (const en of entries) {
      if (!en.isIntersecting) continue;
      counters.unobserve(en.target);
      const el = en.target as HTMLElement;
      const end = Number(el.dataset.count);
      if (reduced || !Number.isFinite(end)) continue;
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1100);
        el.textContent = fmt.format(Math.round(end * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }, { threshold: 0.6 });
  for (const el of $$("[data-count]")) counters.observe(el);

  // ── reveal on scroll + chapter highlight
  document.documentElement.classList.add("js");
  const reveal = new IntersectionObserver((entries) => {
    for (const en of entries) if (en.isIntersecting) { en.target.classList.add("is-in"); reveal.unobserve(en.target); }
  }, { rootMargin: "0px 0px -10% 0px" });
  for (const el of $$("[data-reveal]")) reveal.observe(el);
  const spy = new IntersectionObserver((entries) => {
    for (const en of entries) {
      if (!en.isIntersecting) continue;
      for (const a of $$<HTMLAnchorElement>("[data-chapter]")) {
        const on = a.dataset.chapter === en.target.id;
        a.classList.toggle("is-on", on);
        if (on) a.scrollIntoView({ block: "nearest", inline: "center", behavior: reduced ? "auto" : "smooth" });
      }
    }
  }, { rootMargin: "-40% 0px -55% 0px" });
  for (const el of $$(".chapter[id]")) spy.observe(el);

  // ── share
  const toast = $<HTMLElement>("[data-toast]")!;
  let toastTimer: number | undefined;
  function say(msg: string) {
    toast.textContent = msg;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { toast.hidden = true; }, 2400);
  }
  for (const btn of $$<HTMLButtonElement>("[data-share]")) {
    btn.addEventListener("click", async () => {
      const base = location.origin + location.pathname;
      let url = base, text = btn.dataset.shareText || document.title;
      if (btn.hasAttribute("data-share-city")) {
        const p = data.places.find((x) => x.place === currentPlace);
        if (p) {
          url = `${base}#ciudad=${encodeURIComponent(p.place)}`;
          text = `${p.place} ha tenido ${p.total} conferencias tech desde ${p.firstYear}. ¿Y tu ciudad?`;
        }
      } else if (btn.dataset.shareHash) url = `${base}#${btn.dataset.shareHash}`;
      try {
        if (navigator.share) await navigator.share({ title: document.title, text, url });
        else {
          await navigator.clipboard.writeText(`${text} ${url}`);
          say("Copiado al portapapeles");
        }
      } catch (err) {
        if ((err as Error).name !== "AbortError") say("No se ha podido compartir");
      }
    });
  }
</script>

<style>
  .story {
    --c-held: var(--recipe-accent);
    --c-online: var(--recipe-em);
    --c-cancel: var(--chimi-primitives-color-plasma-base, #e4572e);
    --c-up: var(--recipe-ink);
    --card: color-mix(in srgb, var(--recipe-ink) 4%, transparent);
    --radius: 14px;
  }

  /* ── hero */
  .hero { padding-block: var(--stack-lg) var(--stack-md); }
  .hero-title {
    font-family: var(--recipe-font-display);
    font-weight: var(--recipe-weight-display);
    font-size: clamp(44px, 9.5vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: var(--stack-sm) 0 var(--stack-md);
    display: flex;
    flex-direction: column;
  }
  .hero-title b { color: var(--recipe-accent); font-weight: inherit; font-variant-numeric: tabular-nums; }
  .hero-title span:nth-child(2) b { color: var(--recipe-em); }
  .lede { color: var(--muted-strong); max-width: 62ch; margin: 0; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.55; }
  .hero-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin: var(--stack-md) 0 0; background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 768px) { .hero-stats { grid-template-columns: repeat(4, 1fr); } }
